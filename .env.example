# Copia este ficheiro para ".env" e ajusta antes de correr a API.

# Chave exigida no cabeçalho "X-API-Key" nos endpoints /api/v1/admin/*.
ADMIN_API_KEY=troca-isto-por-uma-chave-forte-e-secreta

# --- Supabase (persistência do tarifário) ---
# SUPABASE_URL e SUPABASE_ANON_KEY já têm valores por omissão no código
# (projeto "kriolsync", chave pública/anon, só de leitura) — só precisas de
# as sobrepor se mudares de projeto Supabase.
# SUPABASE_URL=https://ispblrbswkvvkwoeripg.supabase.co
# SUPABASE_ANON_KEY=<anon key>

# Esta é OBRIGATÓRIA para os endpoints /admin/tarifario/aplicar (escrita).
# Vai a: Supabase Dashboard -> Project Settings -> API -> "service_role" key.
# NUNCA a exponhas no frontend nem a commits no repositório.
SUPABASE_SERVICE_KEY=troca-isto-pela-tua-service-role-key

# --- CORS ---
# Origens (domínios) autorizadas a chamar a API a partir do browser.
# "*" permite qualquer origem (ok para uma API pública de preços; aperta
# isto se quiseres restringir aos domínios das lojas que integrarem).
CORS_ORIGINS=*
